# Horilla HR — environment template
# Copy to .env and edit for your install:
#   cp .env.dist .env
#
# Local Docker (`make dev`) works WITHOUT this file — compose ships
# documented development defaults. Production (`make prod`) REQUIRES .env.

DJANGO_SETTINGS_MODULE=horilla.settings

# Django
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value
# Use DEBUG=True for local tutorials; set False for production
DEBUG=True
# Comma-separated hostnames (do not use * in production)
ALLOWED_HOSTS=localhost,127.0.0.1
# Must include scheme (http:// or https://)
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Kolkata
# Set to production to force security gates even if DEBUG is accidentally True
# HORILLA_ENV=production

# TLS / reverse proxy (enable when HTTPS terminates in front of the app)
SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000

# Database initialization password (must be unique in production)
DB_INIT_PASSWORD=change-me-db-init-password

# Preferred: single DATABASE_URL (used by django-environ)
# Docker Compose default shape (host = service name `db`):
DATABASE_URL=postgres://horilla_user:change-me-db-password@db:5432/horilla_db

# PostgreSQL credentials used by docker-compose.prod.yml (keep in sync with DATABASE_URL)
POSTGRES_DB=horilla_db
POSTGRES_USER=horilla_user
POSTGRES_PASSWORD=change-me-db-password

# Entrypoint wait host/port (default: db:5432 for Docker Compose)
DB_HOST=db
DB_PORT=5432

# ---- OR discrete DB_* vars when DATABASE_URL is unset (host / SQLite) ----
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=TestDB.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=horilla_db
# DB_USER=horilla_user
# DB_PASSWORD=change-me-db-password
# DB_HOST=localhost
# DB_PORT=5432

# Redis cache (optional for runserver/SQLite; used when REDIS_URL is set)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# Gunicorn (optional)
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info
# GUNICORN_RELOAD=false

# /ready/ returns 503 until run_scheduler has registered jobs. Opt-in, and off
# by default: a stopped scheduler delays background jobs, while a 503 here can
# remove web from the load balancer and stop it serving requests entirely.
# Enable only where a failing readiness probe will not do that.
# HORILLA_REQUIRE_SCHEDULER=0

# Optional AWS S3 media (see horilla/settings/addons.py)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_S3_ADDRESSING_STYLE=virtual
# MEDIA_URL=
# MEDIA_ROOT=
# NAMESPACE=

# Optional GCP media
# GOOGLE_APPLICATION_CREDENTIALS=
# GS_BUCKET_NAME=
# DEFAULT_FILE_STORAGE=horilla.horilla_backends_gcp.PrivateMediaStorage
