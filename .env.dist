# GCP Storage for Media Configuration
# GOOGLE_APPLICATION_CREDENTIALS="pathToYourServiceAccountJsonFile"
# GS_BUCKET_NAME="yourGCPBucketName"
# DEFAULT_FILE_STORAGE="horilla.horilla_backends_gcp.PrivateMediaStorage"
# MEDIA_URL="https://storage.cloud.google.com/yourGCPBucketName/media"
# MEDIA_ROOT="https://storage.cloud.google.com/yourGCPBucketName/media"
# NAMESPACE="private"

# AWS S3 Storage for Media Configuration -- setting AWS_ACCESS_KEY_ID is
# the switch: once it's present, every FileField/ImageField upload
# app-wide (employee documents, Company Setup's MSA/branded
# templates/documents, profile photos, ...) goes to this bucket instead
# of local disk. See horilla/settings/addons.py.
# AWS_ACCESS_KEY_ID="yourAWSAccessKeyId"
# AWS_SECRET_ACCESS_KEY="yourAWSSecretAccessKey"
# AWS_STORAGE_BUCKET_NAME="yourS3BucketName"
# AWS_S3_REGION_NAME="ap-south-1"
# AWS_S3_ADDRESSING_STYLE="virtual"                                  # optional, defaults to "virtual"
# DEFAULT_FILE_STORAGE="horilla.horilla_backends.PrivateMediaStorage" # optional, this is already the default
# NAMESPACE="private"                                                # optional, this is already the default

# Cashfree Payouts V2 + Bank Account Verification -- Company Setup's bank
# account verification (penny drop). Setting CASHFREE_CLIENT_ID is the
# switch. CASHFREE_ENV picks the base URL: "sandbox" (default, test-mode,
# no real money moves) or "production" (real transfers -- every
# "Initiate Penny Drop" click moves real money to the client's bank
# account). See company_onboarding/services/cashfree_client.py.
# CASHFREE_CLIENT_ID="yourCashfreeClientId"
# CASHFREE_CLIENT_SECRET="yourCashfreeClientSecret"
# CASHFREE_ENV="sandbox"
#
# Optional -- only if Cashfree issued separate credentials for
# Verification Suite (Bank Account Verification) distinct from Payouts;
# otherwise the Payouts credentials above are reused for both.
# CASHFREE_VERIFICATION_CLIENT_ID="yourVerificationClientId"
# CASHFREE_VERIFICATION_CLIENT_SECRET="yourVerificationClientSecret"
#
# Optional -- only needed if Cashfree rejects requests with
# "x-cf-signature missing" (accounts with signature-based request
# security enabled). Path to the RSA public key .pem file Cashfree
# issues for your account (Dashboard -> Developers -> API Keys ->
# Payouts -> download the encryption/signature public key). Drop it in
# company_onboarding/keys/ (gitignored for now -- see .gitignore) --
# a bare relative path here (the default, shown below) is resolved
# against BASE_DIR, not the current machine, so this works unchanged
# for every clone of this repo once the key file itself is in place.
# An absolute path still works too, if some deployment genuinely needs
# the key stored elsewhere.
# CASHFREE_SIGNATURE_PUBLIC_KEY_PATH="company_onboarding/keys/cashfree_signature_public_key.pem"



# Supportted Formats for DATABASE_URL :

# PostgreSQL: ``postgres[ql]?://`` or ``p[g]?sql://``
# PostGIS: ``postgis://``
# MySQL: ``mysql://`` or ``mysql2://``
# MySQL (GIS): ``mysqlgis://``
# MySQL Connector Python from Oracle: ``mysql-connector://``
# SQLite: ``sqlite://``
# SQLite with SpatiaLite for GeoDjango: ``spatialite://``
# Oracle: ``oracle://``
# Microsoft SQL Server: ``mssql://``
# PyODBC: ``pyodbc://``
# Amazon Redshift: ``redshift://``
# LDAP: ``ldap://``
